PORT=3000
NODE_ENV=production
FRONTEND_URL=https://tu-frontend.vercel.app
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY=7d
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_SSL=require
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_VEHICLE_PHOTOS_FOLDER=verdemex/vehiculos/fotos
CLOUDINARY_DOCUMENTS_FOLDER=verdemex/documentos

# Odoo Ventas (la llave nunca se expone al frontend)
ODOO_URL=https://verdemex.somoslink.com.mx/odoo
# Opcional: solo si el endpoint técnico vive en otra ruta/dominio
# ODOO_RPC_URL=https://verdemex.somoslink.com.mx
ODOO_DATABASE=nombre_de_la_base_odoo
ODOO_USERNAME=usuario@verdemex.com
ODOO_API_KEY=llave_api_del_usuario_odoo
